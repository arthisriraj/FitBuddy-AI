# Required for real Gemini AI generation.
GOOGLE_API_KEY=your_gemini_api_key_here

# The uploaded project specification names these Gemini models.
# If Google has changed model availability, replace these values with
# models available to your API key.
GEMINI_PRO_MODEL=gemini-1.5-pro
GEMINI_FLASH_MODEL=gemini-1.5-flash

# Keep this false for real Gemini generation.
# Set true temporarily if you want to test the complete app without an API key.
DEMO_MODE=false

# Optional. By default the database is fitbuddy.db in the project root.
# DATABASE_URL=sqlite:///./fitbuddy.db
